# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Public URL of this backend (used to build the Google OAuth redirect_to) and
# the frontend URL to send the browser back to once OAuth/session flows finish.
BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:5173

# Session cookies — false for local http dev, MUST be true in any real
# deployment (cookies with SameSite=None require Secure, i.e. HTTPS).
COOKIE_SECURE=false
# Only set this if frontend and backend share a parent domain
# (e.g. ".fitquest.com") and you want the cookie valid across subdomains.
COOKIE_DOMAIN=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — same one the frontend used to use directly (VITE_SUPABASE_URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Service-role key — Project Settings → API → service_role (SECRET, server-only,
# never expose this to the frontend or commit it). This is what lets the
# backend read/write every table regardless of RLS, since authorization is now
# enforced in this backend's code (src/config/tablePolicies.js), not RLS. It's
# also used for auth operations (login/signup/OAuth exchange/admin profile
# updates) since those never leave this server either.
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage buckets ───────────────────────────────────────────────────────────
# Public bucket for avatars / recipe / exercise / program images
SUPABASE_PUBLIC_BUCKET=uploads
# Private bucket for body-progress photos (signed URLs only, not publicly listable)
SUPABASE_PRIVATE_BUCKET=private-uploads

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Invite code required to create the first admin account via /api/auth/admin-setup.
# Server-only now — never shipped to the client bundle.
ADMIN_INVITE_CODE=change-me-before-deploying

# ── LLM proxy ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Vision-capable — only used for requests carrying an image (e.g. the Food
# Scanner). Free tier at aistudio.google.com/apikey. Optional: if unset, the
# Food Scanner will return an error instead of silently guessing.
GEMINI_API_KEY=
